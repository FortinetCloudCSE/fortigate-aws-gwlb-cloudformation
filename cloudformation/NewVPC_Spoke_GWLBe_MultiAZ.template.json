					"Fn::Select": [
						"4",
						{
							"Ref": "PublicSubnetCIDRs"
						}
					]
				},
				"AvailabilityZone": {
					"Fn::Select": [
						"4",
						{
							"Ref": "AZs"
						}
					]
				},
				"Tags": [
					{
						"Key": "Name",
						"Value": {
							"Fn::Sub": "${AWS::StackName}-PublicSubnet5"
						}
					}
				]
			}
