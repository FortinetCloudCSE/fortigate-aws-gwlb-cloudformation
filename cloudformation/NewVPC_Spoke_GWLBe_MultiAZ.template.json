				"VpcId": {
					"Ref": "VPC"
				},
				"CidrBlock": {
					"Fn::Select": [
						"4",
						{
							"Ref": "PrivateSubnetCIDRs"
						}
					]
				},
				"AvailabilityZone": {
					"Fn::Select": [
						"4",
						{
							"Ref": "AZs"
						}
					]
				},
				"Tags": [
					{
						"Key": "Name",
						"Value": {
							"Fn::Sub": "${AWS::StackName}-PrivateSubnet5"
						}
					}
				]
			}
		},
		"PrivateSubnet6": {
			"Type": "AWS::EC2::Subnet",
			"Condition": "6AZs",
			"Properties": {
				"VpcId": {
					"Ref": "VPC"
				},
				"CidrBlock": {
					"Fn::Select": [
						"5",
						{
							"Ref": "PrivateSubnetCIDRs"
						}
					]
				},
				"AvailabilityZone": {
					"Fn::Select": [
						"5",
						{
							"Ref": "AZs"
						}
					]
				},
